# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# IMPORTANT: For external hosting (e.g., Zeabur, Vercel), use VITE_GEMINI_API_KEY.
# Vite only exposes variables prefixed with VITE_ to the browser.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GOOGLE_API_KEY=

# VITE_SURREALDB_URL: The URL of your SurrealDB instance (e.g., https://my-surreal.cloud)
VITE_SURREALDB_URL=
# VITE_SURREALDB_NS: Namespace
VITE_SURREALDB_NS=
# VITE_SURREALDB_DB: Database name
VITE_SURREALDB_DB=
# VITE_SURREALDB_USER: Username
VITE_SURREALDB_USER=
# HERMES API Integration
# Hermes Agent Configuration
# The public VPS endpoint (e.g. http://76.13.151.81:8642/v1)
HERMES_API_BASE_URL=http://76.13.151.81:8642/v1
# Optional API Key for Authorization: Bearer <key>
HERMES_API_KEY=
# The model identifier to use on the VPS
HERMES_MODEL=hermes-agent
# Timeout for requests in milliseconds
HERMES_TIMEOUT_MS=30000
# Prefix for session identifiers
HERMES_SESSION_PREFIX=dt_
HERMES_API_KEY=

# GENERATION CONFIG
GEMINI_MODEL=gemini-3.1-flash-live-preview
